# YouTube Intelligence backend URL.
# Set this to your deployed FastAPI backend origin.
# Must NOT have a trailing slash.
# Example: https://your-backend.example.com
VITE_YOUTUBE_API_BASE_URL=https://8qgnw9pl-8001.inc1.devtunnels.ms

# Set this to the environment-specific reCAPTCHA v2 site key.
# For local development, use a separate key registered for localhost and 127.0.0.1.
# Never add a reCAPTCHA secret key to VITE_* variables.
VITE_RECAPTCHA_SITE_KEY=PASTE_RECAPTCHA_SITE_KEY_HERE
